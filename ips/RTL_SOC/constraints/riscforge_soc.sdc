# ==============================================================================
# RISCFORGE 1TOPS — Synopsys Design Constraints (SDC)
# ==============================================================================
# Target:  riscforge_soc_subsystem (SoC top-level)
# Version: Ideal case — no real library/technology assumptions
# Usage:   Cadence Genus (synthesis) / Tempus (STA) / Innovus (P&R)
#          Also compatible with Synopsys DC / PrimeTime / ICC2
#
# NOTE: This SDC uses ideal clocks and ideal network assumptions.
#       Replace with actual library characterisation when available.
# ==============================================================================

# ==============================================================================
#  Section 1 — Design Variables
# ==============================================================================
# Central clock period definition — change this one value to retarget frequency.
set CLK_PERIOD   10.0    ;# 100 MHz system clock (ns)
set CLK_NAME     clk_sys

# I/O delay assumptions (fraction of clock period)
set INPUT_DELAY  [expr {$CLK_PERIOD * 0.3}]   ;# 30% of period
set OUTPUT_DELAY [expr {$CLK_PERIOD * 0.3}]   ;# 30% of period

# Transition / load assumptions (ideal, will be replaced by library)
set MAX_TRANSITION 0.5   ;# ns
set MAX_FANOUT     20
set IDEAL_LOAD     0.01  ;# pF (placeholder)

# ==============================================================================
#  Section 2 — Clock Definition
# ==============================================================================
# Single system clock — drives all synchronous logic.
create_clock -name $CLK_NAME -period $CLK_PERIOD [get_ports clk_i]

# Clock uncertainty (jitter + skew placeholder for ideal case)
set_clock_uncertainty -setup 0.2 [get_clocks $CLK_NAME]
set_clock_uncertainty -hold  0.1 [get_clocks $CLK_NAME]

# Clock transition (ideal — will be driven by CTS later)
set_clock_transition 0.1 [get_clocks $CLK_NAME]

# ==============================================================================
#  Section 3 — Generated / Virtual Clocks
# ==============================================================================
# SPI output clock — generated by spi_master_clkgen from clk_i.
# The actual divider ratio is runtime-programmable (SPI_CLK_DIV register).
# For STA, constrain with worst-case divide ratio.
create_generated_clock -name spi_clk_gen \
  -source [get_ports clk_i] \
  -divide_by 2 \
  [get_ports spi_clk_o]

# Virtual clock for off-chip I/O timing (no physical source in design)
create_clock -name clk_virtual -period $CLK_PERIOD

# ==============================================================================
#  Section 4 — Clock Network Assumptions (Ideal — Pre-CTS)
# ==============================================================================
# Ideal clock network — no insertion delay, no skew.
# Remove these after CTS (clock tree synthesis) is complete.
set_ideal_network [get_ports clk_i]
set_ideal_network [get_nets sys_rst_n]

# All resets treated as ideal nets (will be buffered by CTS/reset tree)
set_ideal_network [get_ports hard_rst_ni]
set_ideal_network [get_ports soft_rst_ni]

# ==============================================================================
#  Section 5 — Reset Constraints
# ==============================================================================
# Asynchronous resets — mark as false paths for STA.
# The async assertion is by design; only the de-assertion edge needs
# to meet recovery/removal timing (handled by the tool automatically
# once real libraries with recovery/removal arcs are loaded).

# External reset inputs
set_false_path -from [get_ports hard_rst_ni]
set_false_path -from [get_ports soft_rst_ni]

# ==============================================================================
#  Section 6 — Input Constraints
# ==============================================================================
# All inputs constrained relative to the system clock.
# Using set_input_delay with virtual clock for off-chip interfaces.

# --- I2C ---
set_input_delay -clock $CLK_NAME $INPUT_DELAY [get_ports i2c_scl_i]
set_input_delay -clock $CLK_NAME $INPUT_DELAY [get_ports i2c_sda_i]

# --- UART ---
set_input_delay -clock $CLK_NAME $INPUT_DELAY [get_ports uart_sin_i]
set_input_delay -clock $CLK_NAME $INPUT_DELAY [get_ports uart_ctsn_i]
set_input_delay -clock $CLK_NAME $INPUT_DELAY [get_ports uart_dsrn_i]
set_input_delay -clock $CLK_NAME $INPUT_DELAY [get_ports uart_dcdn_i]
set_input_delay -clock $CLK_NAME $INPUT_DELAY [get_ports uart_rin_i]

# --- GPIO ---
set_input_delay -clock $CLK_NAME $INPUT_DELAY [get_ports gpio_in_i[*]]

# --- SPI Data In ---
set_input_delay -clock spi_clk_gen $INPUT_DELAY [get_ports spi_sdi0_i]
set_input_delay -clock spi_clk_gen $INPUT_DELAY [get_ports spi_sdi1_i]
set_input_delay -clock spi_clk_gen $INPUT_DELAY [get_ports spi_sdi2_i]
set_input_delay -clock spi_clk_gen $INPUT_DELAY [get_ports spi_sdi3_i]

# --- CLIC interrupt sources ---
set_input_delay -clock $CLK_NAME $INPUT_DELAY [get_ports clic_intr_src_i[*]]

# --- Core control ---
set_input_delay -clock $CLK_NAME $INPUT_DELAY [get_ports fetch_enable_i]
set_input_delay -clock $CLK_NAME $INPUT_DELAY [get_ports boot_addr_i[*]]

# --- Test mode ---
set_input_delay -clock $CLK_NAME $INPUT_DELAY [get_ports test_mode_i]

# ==============================================================================
#  Section 7 — Output Constraints
# ==============================================================================

# --- Boot status ---
set_output_delay -clock $CLK_NAME $OUTPUT_DELAY [get_ports boot_done_o]

# --- I2C ---
set_output_delay -clock $CLK_NAME $OUTPUT_DELAY [get_ports i2c_scl_o]
set_output_delay -clock $CLK_NAME $OUTPUT_DELAY [get_ports i2c_scl_oen_o]
set_output_delay -clock $CLK_NAME $OUTPUT_DELAY [get_ports i2c_sda_o]
set_output_delay -clock $CLK_NAME $OUTPUT_DELAY [get_ports i2c_sda_oen_o]
set_output_delay -clock $CLK_NAME $OUTPUT_DELAY [get_ports i2c_interrupt_o]

# --- Timer ---
set_output_delay -clock $CLK_NAME $OUTPUT_DELAY [get_ports timer_irq_o[*]]

# --- UART ---
set_output_delay -clock $CLK_NAME $OUTPUT_DELAY [get_ports uart_sout_o]
set_output_delay -clock $CLK_NAME $OUTPUT_DELAY [get_ports uart_int_o]
set_output_delay -clock $CLK_NAME $OUTPUT_DELAY [get_ports uart_out1n_o]
set_output_delay -clock $CLK_NAME $OUTPUT_DELAY [get_ports uart_out2n_o]
set_output_delay -clock $CLK_NAME $OUTPUT_DELAY [get_ports uart_rtsn_o]
set_output_delay -clock $CLK_NAME $OUTPUT_DELAY [get_ports uart_dtrn_o]

# --- GPIO ---
set_output_delay -clock $CLK_NAME $OUTPUT_DELAY [get_ports gpio_out_o[*]]
set_output_delay -clock $CLK_NAME $OUTPUT_DELAY [get_ports gpio_tx_en_o[*]]
set_output_delay -clock $CLK_NAME $OUTPUT_DELAY [get_ports gpio_in_sync_o[*]]
set_output_delay -clock $CLK_NAME $OUTPUT_DELAY [get_ports gpio_global_interrupt_o]
set_output_delay -clock $CLK_NAME $OUTPUT_DELAY [get_ports gpio_pin_level_interrupts_o[*]]

# --- SPI Master ---
set_output_delay -clock spi_clk_gen $OUTPUT_DELAY [get_ports spi_clk_o]
set_output_delay -clock spi_clk_gen $OUTPUT_DELAY [get_ports spi_csn0_o]
set_output_delay -clock spi_clk_gen $OUTPUT_DELAY [get_ports spi_csn1_o]
set_output_delay -clock spi_clk_gen $OUTPUT_DELAY [get_ports spi_csn2_o]
set_output_delay -clock spi_clk_gen $OUTPUT_DELAY [get_ports spi_csn3_o]
set_output_delay -clock spi_clk_gen $OUTPUT_DELAY [get_ports spi_mode_o[*]]
set_output_delay -clock spi_clk_gen $OUTPUT_DELAY [get_ports spi_sdo0_o]
set_output_delay -clock spi_clk_gen $OUTPUT_DELAY [get_ports spi_sdo1_o]
set_output_delay -clock spi_clk_gen $OUTPUT_DELAY [get_ports spi_sdo2_o]
set_output_delay -clock spi_clk_gen $OUTPUT_DELAY [get_ports spi_sdo3_o]
set_output_delay -clock $CLK_NAME  $OUTPUT_DELAY [get_ports spi_events_o[*]]

# --- CLIC observability ---
set_output_delay -clock $CLK_NAME $OUTPUT_DELAY [get_ports clic_irq_valid_o]
set_output_delay -clock $CLK_NAME $OUTPUT_DELAY [get_ports clic_irq_id_o[*]]
set_output_delay -clock $CLK_NAME $OUTPUT_DELAY [get_ports clic_irq_level_o[*]]
set_output_delay -clock $CLK_NAME $OUTPUT_DELAY [get_ports clic_irq_shv_o]
set_output_delay -clock $CLK_NAME $OUTPUT_DELAY [get_ports clic_irq_priv_o[*]]
set_output_delay -clock $CLK_NAME $OUTPUT_DELAY [get_ports clic_irq_kill_req_o]

# ==============================================================================
#  Section 8 — Design Rule Constraints
# ==============================================================================
set_max_transition $MAX_TRANSITION [current_design]
set_max_fanout     $MAX_FANOUT     [current_design]

# Ideal load on all outputs (placeholder — replace with pad/library load)
set_load $IDEAL_LOAD [all_outputs]

# ==============================================================================
#  Section 9 — Clock Domain Crossing (CDC) False Paths
# ==============================================================================
# SPI generated clock ↔ system clock: the SPI IP handles synchronisation
# internally. Mark CDC paths as false for STA.
set_false_path -from [get_clocks $CLK_NAME]    -to [get_clocks spi_clk_gen]
set_false_path -from [get_clocks spi_clk_gen]  -to [get_clocks $CLK_NAME]

# ==============================================================================
#  Section 10 — Multicycle Paths (if any)
# ==============================================================================
# Currently none. Add multicycle path exceptions here if:
#  - SRAM read latency > 1 cycle
#  - AXI crossbar pipeline stages > 0
#  - Any IP uses registered outputs with known multi-cycle semantics

# ==============================================================================
#  Section 11 — Operating Conditions (Ideal — Placeholder)
# ==============================================================================
# Uncomment and replace with actual library operating conditions:
# set_operating_conditions -max <slow_corner> -min <fast_corner>

# Wire load model — ideal (no wire parasitics assumed)
# Uncomment when library is available:
# set_wire_load_model -name <model_name> -library <lib_name>
# set_wire_load_mode  enclosed

# ==============================================================================
#  Section 12 — Area / Power Constraints (Optional)
# ==============================================================================
# Uncomment to enable area/power optimisation targets:
# set_max_area 0        ;# Let the tool minimise area
# set_max_dynamic_power 0
# set_max_leakage_power 0

# ==============================================================================
#  Section 13 — Dont-Touch / Dont-Use Constraints
# ==============================================================================
# Preserve SRAM macros — do not optimise or restructure
# Uncomment when SRAM macro cells are available:
# set_dont_touch [get_cells i_isram/mem_reg*]
# set_dont_touch [get_cells i_dsram/mem_reg*]

# ==============================================================================
#  End of SDC
# ==============================================================================
puts "INFO: RISCFORGE SoC SDC loaded — ideal clock/network constraints active."
