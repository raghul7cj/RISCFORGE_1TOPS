flowchart TB
    subgraph Signals[Key signals through the pipeline]
        VD[valid_D]
        VE[valid_E]
        VM[valid_M]
        VW[valid_W]
        ED[exc_valid_D]
        EE[exc_valid_E]
        EM[exc_valid_M]
        EW[exc_valid_W]
        MRETD[is_mret_E]
        MRETM[is_mret_M]
        MRETW[is_mret_W]
    end

    subgraph Commit[WB commit controller]
        TCOMMIT[trap_commit = valid_W & exc_valid_W]
        MCOMMIT[mret_commit = valid_W & is_mret_W & ~exc_valid_W]
        REDIR[wb_trap_redirect]
        TARGET[trap_target]
        FLUSH[flush_pipeline_onehot = 4'b1111]
    end

    subgraph CSR[CSR regfile]
        TRAPPORT[trap_valid / trap_cause / trap_pc / trap_addr]
        MRETPORT[csr_write_en_mret / csr_waddr_mret / csr_wdata_mret]
        MSTATUS[mstatus update]
        MEPC[mepc update]
        MCAUSE[mcause update]
        MTVAL[mtval update]
    end

    VD --> VE --> VM --> VW
    ED --> EE --> EM --> EW
    MRETD --> MRETM --> MRETW

    VW --> TCOMMIT
    EW --> TCOMMIT
    MRETW --> MCOMMIT

    TCOMMIT --> REDIR
    MCOMMIT --> REDIR
    REDIR --> TARGET
    REDIR --> FLUSH

    TCOMMIT --> TRAPPORT
    TRAPPORT --> MEPC
    TRAPPORT --> MCAUSE
    TRAPPORT --> MTVAL
    MCOMMIT --> MRETPORT
    MRETPORT --> MSTATUS
