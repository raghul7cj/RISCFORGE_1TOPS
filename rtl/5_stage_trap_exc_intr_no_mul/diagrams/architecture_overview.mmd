flowchart LR
    subgraph IF[IF Stage]
        PC[PC register]
        IMEM[Instruction Memory]
        PCMUX[Next PC Mux]
    end

    subgraph ID[ID Stage]
        DEC[decode_cycle]
        CTRL[Control_Unit_Top]
        RF[Register_File]
    end

    subgraph EX[EX Stage]
        EXU[execute_cycle]
        ALU[ALU]
        JB[JB_unit]
    end

    subgraph MEM[MEM Stage]
        MEMU[memory_cycle]
        DMEM[Data_Memory]
        LS[ls_unit]
    end

    subgraph WB[WB Stage]
        WBMUX[writeback_cycle]
    end

    subgraph CSR[CSR / Privileged Path]
        CSRRF[csr_regfile]
        WBCOMMIT[wb_trap_mret_commit_controller]
    end

    subgraph HZ[Hazard Path]
        HAZ[hazard_unit]
    end

    PC --> IMEM --> DEC --> EXU --> MEMU --> WBMUX
    CTRL --> DEC
    RF --> DEC
    EXU --> ALU
    EXU --> JB
    MEMU --> DMEM
    MEMU --> LS
    WBMUX --> RF

    EXU --> HAZ
    MEMU --> HAZ
    WBMUX --> HAZ
    WBCOMMIT --> HAZ

    EXU --> WBCOMMIT
    MEMU --> WBCOMMIT
    WBMUX --> WBCOMMIT
    WBCOMMIT --> PCMUX
    WBCOMMIT --> CSRRF
    CSRRF --> WBCOMMIT
    CSRRF --> PCMUX
    PCMUX --> PC

    HAZ --> PCMUX
    HAZ --> DEC
    HAZ --> EXU

    style WBCOMMIT fill:#ffe0b2,stroke:#ef6c00,stroke-width:2px
    style CSRRF fill:#e1f5fe,stroke:#0288d1,stroke-width:2px
    style HAZ fill:#ede7f6,stroke:#5e35b1,stroke-width:2px
